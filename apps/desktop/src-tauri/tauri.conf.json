{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Korise",
  "version": "0.1.0",
  "identifier": "com.korah.korise",
  "build": {
    "beforeDevCommand": "npm run build --prefix ../web && npm run start --prefix ../web -- --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Korise",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Contrôle quotidien des petites entreprises",
    "longDescription": "Korise — ventes, caisse et stock pour petites entreprises physiques au Cameroun.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}