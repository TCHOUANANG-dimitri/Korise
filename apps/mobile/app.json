{
  "expo": {
    "name": "Korise",
    "slug": "korise",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/korise-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.korah.bizflow",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brand/korise-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/korise-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Korise utilise la caméra pour scanner les codes-barres des produits.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/korise-icon-white.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing"
    ]
  }
}
